# Copy this file to  application.properties  (same folder) and put your real MySQL details.
# application.properties is listed in .gitignore, so your password is never pushed to GitHub.
spring.application.name=student-ranking
server.port=${SERVER_PORT:8080}

# ---- MySQL ----
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/student_ranking_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC}
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:YOUR_MYSQL_PASSWORD_HERE}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# Tables are created/updated automatically from the entities. No sample data is inserted.
spring.jpa.hibernate.ddl-auto=update
spring.jpa.open-in-view=false
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true

server.error.include-message=always
app.cors.allowed-origins=${CORS_ORIGINS:http://localhost:5173,http://127.0.0.1:5173}
